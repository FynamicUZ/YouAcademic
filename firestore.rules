rules_version = '2';

// Academic Dashboard — every student's data lives under users/{uid}/... and is
// readable and writable only by that signed-in account. Nothing else in the
// database is reachable from the client.
//
// Deploy: Firebase console → Firestore Database → Rules → paste → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
